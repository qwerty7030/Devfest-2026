# Copy to .env.local and fill in. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Video-capable model verified with short outfit clips. See what your key can use with
# `node scripts/list-models.mjs`, compare speed with `node scripts/bench-models.mjs frame.jpg`.
GEMINI_MODEL=gemini-3.5-flash

# minimal | low | medium | high | off. Lower = faster. Some models reject "minimal".
GEMINI_THINKING=low

# App-wide ceilings shared by live analysis and final reports. Set these at or
# below your actual project's limits in AI Studio. Restart after changing them.
GEMINI_APP_REQUESTS_PER_MINUTE=4
GEMINI_APP_REQUESTS_PER_DAY=100
