# Copy to .env.local and fill in. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Comma-separated fallback chain: each model has its own daily quota, so on a 429
# the backend moves to the next one. See what your key can use with
# `node scripts/list-models.mjs`, compare speed with `node scripts/bench-models.mjs frame.jpg`.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# minimal | low | medium | high | off. Lower = faster. Some models reject "minimal".
GEMINI_THINKING=low
